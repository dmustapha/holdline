# Holdline — credentials manifest (placeholders only; never commit real secrets)

# Paid Solana mainnet RPC — keeper + server reads (public mainnet-beta rate-limits the keeper). Obtain: Helius/QuickNode/Triton dashboard. Required before: build
RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE_ME
# Public read RPC for the frontend. Obtain: same provider or public endpoint. Required before: deploy
NEXT_PUBLIC_RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE_ME

# Keeper keypair (base58 or JSON array) — signs unattended release_repay. Funded with a little SOL for fees. Store OFF-HOST (secret store), never in the web bundle / .env.local on Vercel. Obtain: `solana-keygen new`. Required before: build
KEEPER_SECRET=REPLACE_ME
# Keeper public key (the vault's authorized poker). Required before: build (init_vault)
KEEPER_PUBKEY=REPLACE_ME

# Demo wallet secret — holds real xStock (TSLAx/SPYx via Jupiter/Backpack) + USDC for borrow + Protect reserve. The judged demo account. Obtain: fund manually. Required before: build (seed-demo)
DEMO_WALLET=REPLACE_ME

# Pinned mainnet addresses (verified in forge hour-1 probe)
KLEND_PROGRAM_ID=KLend2g3cP87fffoy8q1mQqGKjrxjC8boSyAYavgmjD
XSTOCKS_MARKET=5wJeMrUYECGq41fxRESKALVcHnNX26TAWy4W98yULsua
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Minted at deploy. Required before: deploy
HOLDLINE_VAULT_PROGRAM_ID=DEPLOY_AND_RECORD

# Keeper tuning
POLL_MS=60000

# Frontend (app/) — pre-armed live demo position shown on first visit (USER-ONBOARDING O-1).
# The deployed URL opens on this real Kamino obligation so judges see the story before connecting.
NEXT_PUBLIC_DEMO_OBLIGATION=REPLACE_WITH_SEEDED_DEMO_OBLIGATION
NEXT_PUBLIC_DEMO_OWNER=REPLACE_WITH_DEMO_WALLET_PUBKEY
# Keeper heartbeat file the frontend reads for liveness (E-3/E-6). Defaults to ../keeper/status.json.
# KEEPER_STATUS_PATH=/absolute/path/to/keeper/status.json
